{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64-debug",
      "displayName": "x64 Debug (clang-cl + vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang-cl.exe",
        "CMAKE_TOOLCHAIN_FILE": "D:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "WINFSP_SOURCE_ROOT": "D:/src/winfsp-memfs-2.2B5-private-092109",
        "MEMFS_STATIC_WINFSP": "ON",
        "WINFSP_DRIVER_X64_SOURCE": "${sourceDir}/dist/winfsp-2.2.26286-beta5/drivers/winfsp-x64.sys",
        "WINFSP_DRIVER_ARM64_SOURCE": "${sourceDir}/dist/winfsp-2.2.26286-beta5/drivers/winfsp-a64.sys",
        "WINFSP_EXPECTED_VERSION": "2.2"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release (clang-cl + vcpkg)",
      "inherits": "x64-debug",
      "binaryDir": "${sourceDir}/build/x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release"
    }
  ],
  "testPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
